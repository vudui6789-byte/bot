{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-16",
  "keep_vars": true,
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TASK_STORE",
        "class_name": "TaskStore"
      }
    ]
  },
  "exports": {
    "TaskStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
