{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "company-automation-bot-db",
      "database_id": "3494d80b-3e77-40da-ab15-f699e9c3ca77",
      "migrations_dir": "migrations"
    }
  ]
}
