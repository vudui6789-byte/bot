{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "company-automation-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "company-automation-bot-db",
      "database_id": "b8becabc-4c62-4cf8-ab57-53b3cc38fdcd",
      "migrations_dir": "migrations"
    }
  ]
}
